---
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
	return [{ params: { slug: "example" } }];
}

const { slug } = Astro.params;
---

<BaseLayout
	title={`Speaker: ${slug}`}
	description="Speaker detail placeholder."
>
	<h1 class="font-display text-3xl font-semibold tracking-tight">
		Speaker: {slug}
	</h1>
	<p class="text-foreground-muted mt-3 max-w-prose">
		Placeholder speaker detail page for <code class="text-foreground">{slug}</code>.
	</p>
</BaseLayout>
