---
import { site } from "../config/site.ts";
---

<footer class="border-border bg-surface border-t">
	<div
		class="text-foreground-muted mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-4 py-6 text-sm"
	>
		<p>
			&copy; {new Date().getFullYear()}
			{site.name}
		</p>
		<p>
			<a
				href="/code-of-conduct"
				class="hover:text-foreground underline-offset-4 hover:underline"
			>
				Code of Conduct
			</a>
		</p>
	</div>
</footer>
